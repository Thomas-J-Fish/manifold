{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "outDir": "out/main",
    "rootDir": "electron",
    "types": ["node"]
  },
  "include": ["electron/**/*.ts"]
}
